{
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "TinyTeX latexmk",
      "tools": [
        "tinytex-latexmk"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "tinytex-latexmk",
      "command": "/home/jrudoler/.TinyTeX/bin/x86_64-linux/latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%DIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "/home/jrudoler/.TinyTeX/bin/x86_64-linux:/home/jrudoler/bin:/home/jrudoler/perl5/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin:/bin"
      }
    }
  ]
}
