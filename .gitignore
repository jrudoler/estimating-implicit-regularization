# External data downloads (MNIST lives under data/raw/MNIST via the workflow).
data/raw/MNIST/
wandb/
inductive-bias/

# SLURM and training logs
logs/
lightning_logs/

# Local W&B account/project and finished sweep IDs
config/sweeps.local.yaml

# Generated artifacts (workflow reproduces these from data/raw, data/provided,
# and W&B). Commit paper/generated/ from inside the paper submodule, not here.
data/generated/
results/
saved_models/
checkpoints/
dummy/
notebooks/artifacts/
artifacts/

# Snakemake state
.snakemake/

# Python
__pycache__/
*.pyc
*.cpython*
.venv/

# Local IDE / editor configuration
.vscode/

# Claude Code local state (settings.local.json is already user-ignored;
# also drop NFS lockfile leftovers and any future per-user state).
.claude/.nfs*

# Smoketest checkpoint outputs (regenerated locally; the .ckpt blobs embed
# absolute paths, so they should not be committed).
tests/smoketest_checkpoints/*.ckpt
