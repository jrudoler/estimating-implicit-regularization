# Top-level Snakefile for the inductive-bias workflow.
#
# Common invocations:
#   uv run snakemake --cores 4 figures
#     Rebuild all paper-bound figures from existing data/generated/ snapshots.
#     Everything runs locally; GPU rules will use whichever CUDA device the
#     shell sees (or fall back to CPU).
#
#   uv run snakemake --profile workflow/profiles/slurm paper
#     Training rules submit to SLURM with per-rule resources (GPU, mem,
#     runtime declared in workflow/rules/train.smk). Cheap rules (plotting,
#     W&B pulls, stages, latexmk) stay on the submitting host thanks to the
#     `localrules:` directive below.
#
#   uv run snakemake --cores 4 results/figures/barrett_igr_figure2.pdf
#     Rebuild only one figure's sub-DAG.
#
#   uv run snakemake --profile workflow/profiles/slurm launch_wandb_sweep --config analysis=<name>
#     Opt-in: create sweep + submit N SLURM agents, capture the new ID, wait.
#
#   uv run snakemake --forcerun pull_wandb_sweep \
#       --cores 4 results/figures/elasticnet_recovery_mean_se.pdf
#     Force a W&B re-pull for one analysis and rebuild only its figure.


include: "rules/common.smk"
include: "rules/wandb.smk"
include: "rules/train.smk"
include: "rules/plot.smk"
include: "rules/paper.smk"


# Cheap rules that should always run on the submitting host, even under
# --executor slurm. Training rules are deliberately omitted so they do
# submit to the cluster when a SLURM profile is active.
localrules:
    all,
    figures,
    paper,
    stage_all_paper_figures,
    stage_paper_figure,
    stage_preserved_figure,
    plot_method_vis,
    plot_barrett_igr_figure2,
    plot_barrett_igr_long_horizon,
    plot_elasticnet_recovery,
    plot_dropout_bias_ridge_panel,
    plot_ols_composite,
    plot_ols_bootstrap_composite,
    plot_llm_ridge_model_grid,
    plot_llm_ridge_bootstrap_grid,
    plot_llm_ridge_chunk_grid,
    pull_wandb_sweep,
    launch_wandb_sweep,
    paper_pdf,


PAPER_FIGURES = [
    "results/figures/tradeoff-vis.pdf",
    "results/figures/sgd-vs-full-batch.pdf",
    "results/figures/elasticnet_recovery_mean_se.pdf",
    "results/figures/dropout_bias_ridge_panel.pdf",
    "results/figures/barrett_igr_figure2.pdf",
    "results/figures/ols_composite.pdf",
    "results/figures/ols_bootstrap_composite.pdf",
]


rule all:
    input:
        "paper/main.pdf",


rule figures:
    """Rebuild every paper-bound figure under results/figures/."""
    input:
        PAPER_FIGURES,


rule paper:
    """Compile paper/main.pdf from staged figures."""
    input:
        "paper/main.pdf",
